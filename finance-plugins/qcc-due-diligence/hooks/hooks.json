{
  "description": "SessionStart hook that warns when QCC_API_KEY is not configured.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/check_env.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
