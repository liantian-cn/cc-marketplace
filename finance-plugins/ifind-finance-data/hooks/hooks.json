{
  "description": "SessionStart hook that warns when IFIND_API_KEY is not configured.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check_env.js"],
            "timeoutMs": 15000
          }
        ]
      }
    ]
  }
}
